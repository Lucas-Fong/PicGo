  <script>
(function(){try{
  if(window.self!==window.top&&!window.electron)return;
  var parseStorageValue=function(v){if(v===null)return null;try{var parsed=JSON.parse(v);if(typeof parsed==='string')return parsed}catch(e){}return v};
  var themeMode=parseStorageValue(localStorage.getItem('qqcom-theme-mode'));
  var isDark=themeMode==='dark'||((themeMode==='system'||!themeMode)&&window.matchMedia&&window.matchMedia('(prefers-color-scheme:dark)').matches);
  if(isDark){
    document.body.setAttribute('qqcom-theme','dark');
    document.documentElement.style.colorScheme='dark';
  }
  var fontScale=parseStorageValue(localStorage.getItem('qqcom-font-scale'));
  var ratios={small:0.89,standard:1,large:1.22,extraLarge:1.33};
  if(fontScale&&ratios[fontScale])document.documentElement.style.setProperty('--clientfont-scale',ratios[fontScale]);
}catch(e){}})();
</script>
